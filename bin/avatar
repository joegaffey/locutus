#!/usr/bin/env node
// avatar — a tiny CLI accessory that gives a TUI/CLI agent a face and voice
// through the Agent Avatar UI. No dependencies; talks to the server over HTTP.
//
// Point it at the server with AVATAR_URL (default http://localhost:3000).
//
// Commands:
//   avatar say <text> [--emoji 🎉]     Speak a line in the browser (optional emoji).
//   avatar state <emoji>               Change the avatar's expression, no speech.
//   avatar ask <text> [--emoji 🎤]     Speak a question and print the human's reply.
//                      [--timeout S]    One call = one voice Q&A. Exit 1 on timeout.
//   avatar listen [--timeout 30]       Print the next human reply, then exit.
//                                       --follow keeps printing replies until Ctrl-C.
//   avatar pipe [--emoji 🤖]           Speak each line read from stdin.
//
// Examples:
//   avatar say "Build finished" --emoji ✅
//   avatar state 🤔
//   answer="$(avatar ask "What should I work on next?" --emoji 🎤)"
//   reply="$(avatar listen --timeout 60)"
//   my-tui | avatar pipe

const BASE = (process.env.AVATAR_URL || "http://localhost:3000").replace(/\/$/, "");

// ---- arg parsing ----------------------------------------------------------
const argv = process.argv.slice(2);
const cmd = argv[0];

function getFlag(name) {
  const i = argv.indexOf(`--${name}`);
  if (i === -1) return undefined;
  return argv[i + 1];
}
function hasFlag(name) {
  return argv.includes(`--${name}`);
}
// Positional args are everything after the command that isn't a flag/flag-value.
function positionals() {
  const out = [];
  for (let i = 1; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      i++; // skip its value
      continue;
    }
    out.push(a);
  }
  return out;
}

// ---- HTTP helpers ---------------------------------------------------------
async function postMessage(text, emoji) {
  const body = {};
  if (text) body.text = text;
  if (emoji) body.emoji = emoji;
  const res = await fetch(`${BASE}/api/messages`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body),
  });
  if (!res.ok) {
    const detail = await res.text().catch(() => "");
    throw new Error(`POST /api/messages -> ${res.status} ${detail}`);
  }
  return res.json();
}

async function poll(since) {
  const res = await fetch(`${BASE}/api/messages?since=${since}`);
  if (!res.ok) throw new Error(`GET /api/messages -> ${res.status}`);
  return res.json();
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

function die(msg) {
  console.error(msg);
  process.exit(1);
}

// ---- commands -------------------------------------------------------------
async function cmdSay() {
  const text = positionals().join(" ");
  const emoji = getFlag("emoji");
  if (!text && !emoji) die('say: provide text (and/or --emoji). e.g. avatar say "hi" --emoji 👋');
  await postMessage(text, emoji);
}

async function cmdState() {
  const emoji = positionals()[0] || getFlag("emoji");
  if (!emoji) die("state: provide an emoji. e.g. avatar state 🤔");
  await postMessage("", emoji);
}

async function cmdAsk() {
  const text = positionals().join(" ");
  const emoji = getFlag("emoji");
  const timeout = Number.parseInt(getFlag("timeout") ?? "60", 10);
  const params = new URLSearchParams();
  if (text) params.set("text", text);
  if (emoji) params.set("emoji", emoji);
  params.set("timeout", String(timeout));

  let res;
  try {
    res = await fetch(`${BASE}/api/ask?${params.toString()}`);
  } catch (err) {
    die(`ask: cannot reach ${BASE} (${err.message})`);
  }
  if (res.status === 408) process.exit(1); // timed out, no reply
  if (!res.ok) die(`ask: GET /api/ask -> ${res.status}`);
  const data = await res.json();
  process.stdout.write((data.reply ?? "") + "\n");
}

async function cmdListen() {
  const follow = hasFlag("follow");
  const timeout = Number.parseInt(getFlag("timeout") ?? "30", 10);
  const deadline = follow ? Infinity : Date.now() + timeout * 1000;

  // Start from the latest cursor so we only report *new* replies.
  let cursor;
  try {
    cursor = (await poll(0)).cursor;
  } catch (err) {
    die(`listen: cannot reach ${BASE} (${err.message})`);
  }

  for (;;) {
    if (Date.now() > deadline) process.exit(1); // timed out, no reply
    let batch;
    try {
      batch = await poll(cursor);
    } catch {
      await sleep(1000);
      continue;
    }
    cursor = batch.cursor;
    const replies = batch.messages.filter((m) => m.source === "user" && m.text);
    for (const r of replies) {
      process.stdout.write(r.text + "\n");
      if (!follow) return;
    }
    await sleep(1000);
  }
}

async function cmdPipe() {
  const emoji = getFlag("emoji");
  let buf = "";
  process.stdin.setEncoding("utf8");
  for await (const chunk of process.stdin) {
    buf += chunk;
    let idx;
    while ((idx = buf.indexOf("\n")) !== -1) {
      const line = buf.slice(0, idx).trim();
      buf = buf.slice(idx + 1);
      if (line) await postMessage(line, emoji);
    }
  }
  const tail = buf.trim();
  if (tail) await postMessage(tail, emoji);
}

function usage() {
  console.log(`avatar — give your TUI agent a face and voice.

Server: ${BASE}  (override with AVATAR_URL)

Commands:
  avatar say <text> [--emoji E]   Speak a line (optional expression).
  avatar state <emoji>            Change expression, no speech.
  avatar ask <text> [--emoji E]   Speak a question, print the human's reply.
                  [--timeout S]   One call = one voice Q&A. Exit 1 on timeout.
  avatar listen [--timeout S]     Print the next human reply, then exit.
                  [--follow]      Keep printing replies until Ctrl-C.
  avatar pipe [--emoji E]         Speak each line from stdin.

Examples:
  avatar say "Build finished" --emoji ✅
  avatar state 🤔
  answer="$(avatar ask "What should I work on next?" --emoji 🎤)"
  reply="$(avatar listen --timeout 60)"
  my-tui | avatar pipe`);
}

// ---- dispatch -------------------------------------------------------------
(async () => {
  try {
    switch (cmd) {
      case "say":
        await cmdSay();
        break;
      case "state":
        await cmdState();
        break;
      case "ask":
        await cmdAsk();
        break;
      case "listen":
        await cmdListen();
        break;
      case "pipe":
        await cmdPipe();
        break;
      case "help":
      case "--help":
      case "-h":
      case undefined:
        usage();
        break;
      default:
        die(`unknown command: ${cmd}\nRun 'avatar help' for usage.`);
    }
  } catch (err) {
    die(err.message);
  }
})();
