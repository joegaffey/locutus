{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(curl -sX POST http://localhost:3000/api/messages *)",
      "Bash(curl -sG http://localhost:3000/api/ask *)",
      "Bash(curl -s http://localhost:3000/api/messages*)",
      "Bash(avatar say *)",
      "Bash(avatar state *)",
      "Bash(avatar ask *)",
      "Bash(avatar listen*)",
      "Bash(avatar pipe*)",
      "Bash(./bin/avatar say *)",
      "Bash(./bin/avatar state *)",
      "Bash(./bin/avatar ask *)",
      "Bash(./bin/avatar listen*)",
      "Bash(./bin/avatar pipe*)"
    ]
  }
}
